<!-- Merge into app/src/main/AndroidManifest.xml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The floating button: Android's "Display over other apps". Granted on a settings page,
         never by a dialog; the Settings row opens that page. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Keeping the work alive in the background, with its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- TODO: the type that matches the work, as in KeepAliveService (DrumTrig: microphone). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Android 13+: the notification itself. Ask for it during setup. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
